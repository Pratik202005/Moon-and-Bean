# Moon & Bean Server Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database Connection URI
# Replace with your production MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/moon_and_bean_db?retryWrites=true&w=majority

# Client URLs for CORS (comma-separated if multiple domains)
CLIENT_URL=http://localhost:5173,https://your-moon-and-bean-frontend.vercel.app

# Cryptographic JWT Secret for Authentication
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_string_2026

# Administrator Account Initial Bootstrap
ADMIN_EMAIL=admin@moonandbean.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPassword2026!
